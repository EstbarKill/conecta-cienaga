# ─────────────────────────────────────────────────────────────
# Conecta Ciénaga — Variables de entorno
#
# Copia este archivo como `.env` y completa con tus valores reales.
# NUNCA subas `.env` a Git (ya está en .gitignore).
# NUNCA pongas valores reales en este archivo (.env.example).
# ─────────────────────────────────────────────────────────────

# ── Variables PÚBLICAS ──────────────────────────────────────
# El prefijo PUBLIC_ hace que Astro las incluya en el bundle del
# navegador. Son seguras de exponer: la seguridad real la da RLS
# en la base de datos, no el secreto de estas variables.

PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Variables PRIVADAS (solo servidor) ──────────────────────
# Estas NUNCA deben tener el prefijo PUBLIC_. Astro no las expone
# al navegador. Úsalas únicamente desde código server-side
# (src/config/supabase.admin.ts, endpoints API).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── Entorno ──────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321
