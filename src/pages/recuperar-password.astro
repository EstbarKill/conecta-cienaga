---
import BaseLayout from '../layouts/BaseLayout.astro';
import { requestPasswordReset } from '../services/auth';

let errorMessage: string | null = null;
let showSuccess = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = String(formData.get('email') ?? '').trim();

  if (!email) {
    errorMessage = 'Ingresa tu correo electrónico.';
  } else {
    const siteUrl = import.meta.env.PUBLIC_SITE_URL;
    const redirectTo = `${siteUrl}/api/auth/callback?next=/actualizar-password`;
    const result = await requestPasswordReset(Astro.locals.supabase, email, redirectTo);

    // Por seguridad (evitar enumeración de usuarios), mostramos el
    // mismo mensaje de éxito exista o no una cuenta con ese correo.
    if (result.success || result.error.includes('Demasiados intentos')) {
      showSuccess = result.success;
      if (!result.success) errorMessage = result.error;
    } else {
      showSuccess = true;
    }
  }
}
---

<BaseLayout title="Recuperar contraseña" noindex>
  <main>
    <h1>Recuperar contraseña</h1>
    <p class="subtitle">Te enviaremos un enlace para restablecerla.</p>

    {showSuccess && (
      <div class="alert alert-success" role="status">
        Si existe una cuenta con ese correo, te enviamos un enlace para restablecer tu contraseña.
      </div>
    )}

    {errorMessage && (
      <div class="alert alert-error" role="alert">
        {errorMessage}
      </div>
    )}

    {!showSuccess && (
      <form method="POST" id="recover-form">
        <div>
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <button type="submit" data-loading-text="Enviando...">Enviar enlace</button>
      </form>
    )}

    <div class="auth-links">
      <a href="/login">Volver a iniciar sesión</a>
    </div>
  </main>
</BaseLayout>
