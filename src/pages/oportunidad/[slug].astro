---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug, getPostContact } from '../../services/posts';
import { getMyBusinessProfile } from '../../services/profile';
import type { PostStatus, PostType } from '../../types/database';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const currentUserId = Astro.locals.user?.id ?? null;
const result = await getPostBySlug(Astro.locals.supabase, slug, currentUserId);

if (!result) {
  return new Response(null, { status: 404 });
}

const { post, isOwner } = result;
const isNew = Astro.url.searchParams.get('nuevo') === '1';
const wantsContact = Astro.url.searchParams.get('verContacto') === '1';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://conectacienaga.co').replace(/\/$/, '');
const postUrl = `${siteUrl}/oportunidad/${post.slug}`;
const whatsappShareText = encodeURIComponent(`Mira esta oportunidad en Conecta Ciénaga: ${post.title}\n${postUrl}`);
const whatsappShareUrl = `https://wa.me/?text=${whatsappShareText}`;

let contact: { phone: string | null; whatsapp: string | null; email: string | null } | null = null;
let contactError: string | null = null;

if (isOwner) {
  // El autor ya tiene sus propios datos de contacto en `post`
  // (OWNER_POST_COLUMNS los incluye) — no necesita la RPC ni el clic.
  contact = { phone: post.contactPhone ?? null, whatsapp: post.contactWhatsapp ?? null, email: post.contactEmail ?? null };
} else if (wantsContact) {
  if (!Astro.locals.user) {
    return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname + '?verContacto=1')}`);
  }
  const contactResult = await getPostContact(Astro.locals.supabase, post.id);
  if (contactResult.success) {
    contact = contactResult.data;
  } else {
    contactError = contactResult.error;
  }
}

const authorBusiness = await getMyBusinessProfile(Astro.locals.supabase, post.authorId);

const TYPE_LABELS: Record<PostType, string> = {
  EMPLOYMENT: 'Empleo',
  SERVICE: 'Servicio',
  JOB_SEEKER: 'Busca empleo',
};

const STATUS_MESSAGES: Partial<Record<PostStatus, string>> = {
  PENDING: 'Tu publicación está en revisión. Solo tú puedes verla así.',
  REJECTED: 'Tu publicación fue rechazada.',
  PAUSED: 'Tu publicación está pausada. No aparece en las búsquedas.',
  EXPIRED: 'Tu publicación expiró. Edítala para reactivarla.',
  DRAFT: 'Este es un borrador, aún no se ha enviado a revisión.',
};

// Datos estructurados JobPosting (schema.org) solo para publicaciones
// de tipo EMPLOYMENT ya públicas. Nunca se incluye el contacto (que
// está protegido tras login + clic) — solo información ya visible sin
// autenticarse, para no contradecir esa protección de privacidad.
const showJobPostingSchema = post.type === 'EMPLOYMENT' && post.status === 'PUBLISHED';
const jobPostingSchema = showJobPostingSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'JobPosting',
      title: post.title,
      description: post.description,
      datePosted: post.createdAt,
      validThrough: post.expiresAt,
      employmentType: 'OTHER',
      jobLocation: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressLocality: post.municipio,
          addressRegion: post.departamento,
          addressCountry: 'CO',
        },
      },
      hiringOrganization: {
        '@type': 'Organization',
        name: 'Conecta Ciénaga',
      },
    }
  : null;
---

<BaseLayout title={post.title} description={post.description.slice(0, 160)} noindex={post.status !== 'PUBLISHED'}>
  {jobPostingSchema && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jobPostingSchema)} />
    </Fragment>
  )}
  <main>
    {isNew && (
      <div class="alert alert-success" role="status">
        ¡Publicado! Tu oportunidad está en revisión y aparecerá públicamente cuando sea aprobada.
      </div>
    )}

    {isOwner && post.status !== 'PUBLISHED' && STATUS_MESSAGES[post.status] && (
      <div class="alert alert-error" role="status">
        {STATUS_MESSAGES[post.status]}
        {post.status === 'REJECTED' && post.rejectionReason && (
          <> Motivo: {post.rejectionReason}</>
        )}
      </div>
    )}

    <span class="type-badge">{TYPE_LABELS[post.type]}</span>
    <h1>{post.title}</h1>
    <p class="post-card-meta">{post.categoryName} · {post.municipio}, {post.departamento}</p>
    {post.address && <p class="post-card-meta">📍 {post.address}</p>}
    {authorBusiness && (
      <p class="post-card-meta">Publicado por <a href={`/empresa/${authorBusiness.slug}`}>{authorBusiness.businessName}</a></p>
    )}

    <p>{post.description}</p>

    {post.status === 'PUBLISHED' && (
      <a href={whatsappShareUrl} target="_blank" rel="noopener" class="whatsapp-share-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2m5.8 14.16c-.24.68-1.4 1.32-1.94 1.4-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.98 0-1.42.74-2.11 1-2.4.26-.29.57-.36.76-.36l.55.01c.17.01.41-.07.64.49.24.58.81 2 .88 2.14.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.56.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.64-.14.26.09 1.68.79 1.97.94.28.14.47.21.54.33.07.12.07.68-.17 1.36"/>
        </svg>
        Compartir por WhatsApp
      </a>
    )}

    <section class="contact-box">
      <h2>Contacto</h2>

      {contact ? (
        <ul class="contact-list">
          {contact.whatsapp && <li>WhatsApp: {contact.whatsapp}</li>}
          {contact.phone && <li>Teléfono: {contact.phone}</li>}
          {contact.email && <li>Correo: {contact.email}</li>}
        </ul>
      ) : contactError ? (
        <p class="alert alert-error" role="alert">{contactError}</p>
      ) : (
        <a href={`?verContacto=1`} class="btn-primary-link">Ver contacto</a>
      )}
    </section>

    {isOwner && (
      <p><a href="/mis-publicaciones">← Volver a mis publicaciones</a></p>
    )}

    {!isOwner && currentUserId && (
      <p class="report-link"><a href={`/reportar?post=${post.id}`}>🚩 Reportar esta publicación</a></p>
    )}
  </main>
</BaseLayout>
